PORT=3000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/drakarys
# NEAR operator secret key (ed25519:...) - written to back/.env.near by deploy_near.mjs
NEAR_OPERATOR_ACCOUNT=
# HOST=127.0.0.1   # bind to localhost only when caddy/nginx fronts the app

# X (Twitter) login - https://developer.x.com -> App -> User authentication settings
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_CALLBACK_URL=https://example.com/api/auth/x/callback   # must match the X app setting
# FRONT_URL=https://example.com   # where the browser lands after login (default "/")

# Email+password login - enabled by default, no external deps
# EMAIL_LOGIN=0   # set to 0 to disable

# SMTP for magic-link login emails (Hostinger mailbox)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=ops@xfokus.ai
# SMTP_PASS=
# MAIL_FROM=XFokus.AI <ops@xfokus.ai>
# AUTH_BASE_URL=https://example.com   # public URL embedded in magic links
