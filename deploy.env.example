VPS_HOST=1.2.3.4
VPS_USER=ubuntu
VPS_PASS=your-ssh-password
# VPS_PORT=22
# VPS_DIR=~/drakarys
# DOMAIN=example.com   # serve the site at https://example.com (DNS -> VPS IP)

# Any extra vars here are forwarded into the remote back/.env (everything
# except the deploy-tool vars above). E.g. X login + db:
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_CALLBACK_URL=https://example.com/api/auth/x/callback
# FRONT_URL=https://example.com
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/drakarys
# NEAR_OPERATOR_ACCOUNT=
